# Copy to .env and fill in. Never commit .env.

# LLM used by the AI Loan Assistant (reasoning questions)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# LLM used to write loan-decision explanations (optional;
# falls back to Groq, then to a rule-based summary)
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional overrides
# DATABASE_PATH=database/loan_system.db
# UPLOAD_FOLDER=uploads
# REPORT_FOLDER=reports
# MAX_UPLOAD_SIZE_MB=5

# Tesseract is auto-detected on PATH / default Windows install folder.
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Python used to launch the MCP server (defaults to the app's own)
# MCP_PYTHON=
